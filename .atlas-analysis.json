  "keyFeatures": [
    "OpenAI-compatible /api/v1/chat/completions endpoint",
    "Multi-transport: direct httpx, Chrome fetch, Camoufox (Firefox), userscript proxy",
    "Automatic Cloudflare/reCAPTCHA v3 and v2 challenge handling via browser automation",
    "Round-robin auth token management with auto-refresh via Supabase",
    "Admin dashboard with usage stats, API key management, and token cycling",
    "Image upload support to LMArena R2 storage (up to 10MB)",
    "Rate limiting per API key with configurable RPM",
    "Stealth model support including experimental models",
    "Streaming responses (SSE) with OpenAI-compatible format",
    "Periodic background refresh of models and reCAPTCHA tokens every 30 minutes"
  ],
  "publicApiSurface": [
    "POST /api/v1/chat/completions",
    "GET /api/v1/models",
    "GET /api/v1/health",
    "POST /api/v1/messages",
    "POST /api/v1/userscript/poll",
    "POST /api/v1/userscript/push",
    "GET /dashboard",
    "POST /add-auth-token",
    "POST /delete-auth-token",
    "POST /refresh-tokens",
    "POST /create-key",
    "POST /delete-key"
  ]
